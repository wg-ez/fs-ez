---
source: crates/fs-ez-web/tests/router_phase3.rs
expression: sidebar
---
<aside class="sidebar" id="sidebar" aria-label="Navigation" hx-get="/partials/sidebar" hx-trigger="data-changed from:body, inbox-changed from:body, tags-changed from:body, groups-changed from:body, views-changed from:body" hx-swap="outerHTML">
  

  <div class="sidebar__nav">
    <section class="sidebar__section">
      <ul class="sidebar__list">
        <li>
          <a class="sidebar__link" href="/" title="All files" aria-label="All files">
            <span class="sidebar__name">All files</span>
          </a>
        </li>
        <li>
          <a class="sidebar__link" href="/?filter=untagged" title="Untagged" aria-label="Untagged">
            <span class="sidebar__name">Untagged</span>
          </a>
        </li>
        <li>
          <a class="sidebar__link" href="/?filter=recent" title="Recently tagged" aria-label="Recently tagged">
            <span class="sidebar__name">Recently tagged</span>
          </a>
        </li>
        <li>
          <a class="sidebar__link" href="/?filter=recent-files" title="Recent files" aria-label="Recent files">
            <span class="sidebar__name">Recent files</span>
          </a>
        </li>
        <li>
          <a class="sidebar__link" href="/virtual-folders" title="Virtual folders" aria-label="Virtual folders">
            <span class="sidebar__name">Virtual folders</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="sidebar__section">
      <div class="sidebar__section-head">
        <p class="sidebar__label">Views</p>
        <button class="sidebar__control sidebar__action" type="button" data-view-group-create-open title="Create view group" aria-label="Create view group"><svg class="sidebar__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"></path></svg></button>
      </div>
      <form class="sidebar__group-create" method="post" action="/partials/view-groups" hx-post="/partials/view-groups" hx-target="#sidebar" hx-swap="none" data-view-group-create-form hidden>
        <label class="sr-only" for="sidebar-new-view-group">Name</label>
        <input type="hidden" name="color" value="[color]">
        <span class="dot dot--[color] sidebar__tag-color" data-tag-color aria-hidden="true"></span>
        <span class="sidebar__create-field">
          <input class="input" id="sidebar-new-view-group" name="name" value="" maxlength="64" autocomplete="off" placeholder="New view group" required>
          
          
        </span>
      </form>
      <div class="sidebar__view-create-panel" data-view-create-panel>
<form class="sidebar__view-editor" method="post" action="/views" hx-post="/views" hx-target="#sidebar" hx-swap="none" data-view-editor data-view-id="create" data-view-create-form hidden>
  <input type="hidden" name="group" value="" data-view-group-input>
  <div class="sidebar__view-editor__head">
    <label class="sr-only" for="view-name-create">Name</label>
    <input class="input" id="view-name-create" name="name" value="" maxlength="100" autocomplete="off" placeholder="Name" required>
    <button class="sidebar__control" type="button" data-view-editor-close title="Cancel" aria-label="Cancel"><span aria-hidden="true">&times;</span></button>
  </div>
  <div class="sidebar__view-editor__row">
    <label class="sr-only" for="view-sort-create">Sort</label>
    <select class="input" id="view-sort-create" name="sort" data-dropdown>
      <option value="id:asc">Id (ascending)</option><option value="id:desc">Id (descending)</option><option value="name:asc">Name (ascending)</option><option value="name:desc">Name (descending)</option><option value="size:asc">Size (ascending)</option><option value="size:desc">Size (descending)</option><option value="mtime:asc">Date (ascending)</option><option value="mtime:desc">Date (descending)</option>
    </select>
  </div>
  <div class="sidebar__view-editor__section">
    <span class="micro-label">Color</span>
  </div>
  <div class="sidebar__view-editor__colors" role="radiogroup" aria-label="Color">
    <label class="dot dot--[color] sidebar__tag-swatch" title="Neutral" aria-label="Neutral">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Red" aria-label="Red">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Orange" aria-label="Orange">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Amber" aria-label="Amber">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Green" aria-label="Green">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Teal" aria-label="Teal">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Cyan" aria-label="Cyan">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Blue" aria-label="Blue">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Indigo" aria-label="Indigo">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Violet" aria-label="Violet">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Pink" aria-label="Pink">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>
<label class="dot dot--[color] sidebar__tag-swatch" title="Brown" aria-label="Brown">
  <input class="sr-only" type="radio" name="color" value="[color]">
</label>

  </div>
  <div class="sidebar__view-editor__section">
    <span class="micro-label">Filters</span>
  </div>
  <input type="hidden" name="filter_json" id="view-filter-create" value="">
<div class="builder" data-builder data-filter-input="#view-filter-create" data-remove-label="Remove">
  <div class="builder__group builder__group--root" data-op="and">
    <div class="builder__items"></div>
    <p class="builder__empty">No filter, every file is listed.</p>
    <div class="builder__footer">
      <button type="button" class="builder__add" data-add-condition><svg class="sidebar__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.25v9.5M3.25 8h9.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"></path></svg>Add filter</button>
      <button type="button" class="builder__add" data-add-group><svg class="sidebar__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 4.5h4l1.2 1.5H14v7H2zM8 8.3v3.2M6.4 9.9h3.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>Add filter group</button>
    </div>
  </div>
  <template class="builder-condition-template">
    <div class="builder__condition">
      <select class="builder__logic input" data-dropdown aria-label="Where">
        <option value="where">Where</option>
        <option value="and">And</option>
        <option value="or">Or</option>
      </select>
      <select class="builder__cmp input" data-dropdown aria-label="Operator">
        <optgroup label="Tag">
          <option value="has">contains the tags</option>
          <option value="has_not">does not contain the tags</option>
        </optgroup>
        <optgroup label="Exact tag set">
          <option value="only">contains only the tags</option>
          <option value="not_only">does not contain only the tags</option>
        </optgroup>
      </select>
      <button type="button" class="builder__icon builder__icon--danger" data-remove-condition title="Remove" aria-label="Remove"><svg class="sidebar__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 4h10M6 4V2.5h4V4M4.5 4l.55 9.5h5.9L11.5 4M6.6 6.5v5M9.4 6.5v5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
      <details class="dropdown builder__tagset">
        <summary class="builder__tagset-summary dropdown__trigger">
          <span class="builder__tagset-chips" role="group" aria-label="Exact tag set"></span>
          <span class="builder__tagset-trigger-label">Add tag</span>
        </summary>
        <div class="dropdown__panel dropdown__panel--field builder__tagset-panel">


