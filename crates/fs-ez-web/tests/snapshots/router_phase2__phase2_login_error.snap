---
source: crates/fs-ez-web/tests/router_phase2.rs
expression: "between(&error, \"<main \", \"</main>\")"
---
<main class="login-page">
    <div class="shell shell--login">
      <section class="work work--login">
        <div class="login-card">
          <h1 class="login-title">Sign in</h1>
          
          <p class="banner banner--error" role="alert">Invalid credentials</p>
          
          <form class="login-form" method="post" action="/login">
            
            <input type="hidden" name="next" value="/">
            
            <label class="field">
              <span class="field__label">Username</span>
              <input class="input" type="text" name="username" value="user" autocomplete="username" maxlength="64" required>
            </label>
            <label class="field">
              <span class="field__label">Password</span>
              <input class="input" type="password" name="password" autocomplete="current-password" required>
            </label>
            <button class="btn" type="submit">Sign in</button>
          </form>
        </div>
      </section>
    </div>
  </main>
